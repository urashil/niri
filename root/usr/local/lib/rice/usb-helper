#!/usr/bin/env python3
"""rice-usb: allow a USB device that USBGuard blocked (run through pkexec by the bar's USB prompt).

  allow <port> [permanent]     allow the blocked device on that port (e.g. 3-6, 1-2.4); "permanent" also adds a rule
"""
import re, subprocess, sys

def main():
    if len(sys.argv) < 3 or sys.argv[1] != "allow" or not re.fullmatch(r"\d+-\d+(\.\d+)*", sys.argv[2]):
        sys.exit(__doc__)
    port = sys.argv[2]
    perm = len(sys.argv) > 3 and sys.argv[3] == "permanent"
    out = subprocess.run(["usbguard", "list-devices", "--blocked"], capture_output=True, text=True).stdout
    ids = [m.group(1) for line in out.splitlines() if (m := re.match(r"\s*(\d+): block .*\bvia-port \"" + re.escape(port) + r"\"", line))]
    if not ids:
        sys.exit(f"no blocked device on port {port}")
    r = subprocess.run(["usbguard", "allow-device"] + (["-p"] if perm else []) + [ids[0]], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(r.stderr.strip() or "usbguard refused")
    print("allowed")

main()
