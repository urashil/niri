#!/usr/bin/env python3
"""rice-net: root-side helper for the quickshell network/privacy menu (run through pkexec).

  status                       print JSON state
  mode <network|once|disabled> iwd [General].AddressRandomization (+ restart iwd)
  range <full|nic>             iwd AddressRandomizationRange (nic keeps the vendor prefix)
  always <ssid> <on|off>       per-network AlwaysRandomizeAddress (fresh MAC on every connect)
  rotate                       new MAC now: always-random on the current network, reconnect
  duid                         new DHCP identity now: wipe iwd's stored DUID/client-id, reconnect
  duid-rotate <on|off>         wipe that DUID on every iwd start, so the DHCP identity (which survives MAC
                               changes) is fresh on each boot and each reconnect
  hostname <name|random>       the hostname Wi-Fi networks see (DHCP). Only iwd gets it, in a private hostname
                               namespace (systemd ProtectHostname=private:NAME); the system hostname is never changed
  dhcp-hostname <on|off>       announce that name on every saved network (off: iwd sends no hostname at all)
  rule <ssid> <random|stable|custom> [mac]
                               per-network MAC policy (switches iwd to 'network' mode if needed)
  rules                        JSON list of saved networks and their policy
  pia <school|auto>            PIA OpenVPN transport: TCP/443 ('school') or back to automatic
  pia-killswitch <on|auto|off> PIA killswitch: always on / only with the VPN / off
  vpn-daemon <pia|mullvad|ivpn> enable + start that VPN client's daemon, stop + disable the others (only one may
                               own the firewall and DNS)
  boot-hostname <on|off>       pick a new random Wi-Fi hostname at every boot (before iwd starts)
  harden <on|off>              no LLMNR/mDNS announcements, IPv6 temporary addresses
  pia-set <option> <value>     multihop on [region]|off (Shadowsocks proxy in front, OpenVPN only), mace on|off,
                               obfuscation on|off (WireGuard), ipv6block on|off. Restarts the PIA daemon.
  dns-guard <on|off>           sign-in page mode: off = the network's own DNS (no DoH, no local DNSSEC check, plain
                               DNS allowed), on = back to DoH and the plain DNS block
"""
import configparser, json, os, random, re, socket, string, subprocess, sys

MAIN = "/etc/iwd/main.conf"
STATE_DIR = "/var/lib/rice-net"
STATE = STATE_DIR + "/state.json"
IWD_DIR = "/var/lib/iwd"
IFACE = "wlan0"
VPN_UNITS = {"pia": "piavpn", "mullvad": "mullvad-daemon", "ivpn": "ivpn-service"}

def run(*a, check=False):
    return subprocess.run(a, capture_output=True, text=True, check=check)

def read_main():
    c = configparser.ConfigParser(strict=False, interpolation=None)
    c.optionxform = str
    c.read(MAIN)
    return c

def write_main(c):
    os.makedirs(os.path.dirname(MAIN), exist_ok=True)
    with open(MAIN, "w") as f:
        c.write(f, space_around_delimiters=False)

def restart_iwd():
    run("systemctl", "restart", "iwd")

def net_file(ssid):
    safe = re.fullmatch(r"[A-Za-z0-9 _-]+", ssid) is not None
    base = ssid if safe else "=" + ssid.encode().hex()
    for ext in (".psk", ".open", ".8021x"):
        p = os.path.join(IWD_DIR, base + ext)
        if os.path.exists(p):
            return p
    return None

def current_ssid():
    out = run("iwctl", "station", IFACE, "show").stdout
    out = re.sub(r"\x1b\[[0-9;]*m", "", out)
    m = re.search(r"Connected network\s+(.+?)\s*$", out, re.M)
    return m.group(1).strip() if m else None

def set_always(ssid, on):
    p = net_file(ssid)
    if not p:
        sys.exit(f"no saved profile for '{ssid}' (connect to it once first)")
    c = configparser.ConfigParser(strict=False, interpolation=None)
    c.optionxform = str
    c.read(p)
    if not c.has_section("Settings"):
        c.add_section("Settings")
    c["Settings"]["AlwaysRandomizeAddress"] = "true" if on else "false"
    with open(p, "w") as f:
        c.write(f, space_around_delimiters=False)
    os.chmod(p, 0o600)

def random_hostname():
    return "DESKTOP-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=7))

DROPIN_DIR = "/etc/systemd/system/iwd.service.d"
DROPIN = DROPIN_DIR + "/rice-hostname.conf"
DUID = IWD_DIR + "/.duid"                       # iwd's stored DHCP DUID / client identifier (stable across MACs)
DUID_DROPIN = DROPIN_DIR + "/rice-duid.conf"

def wipe_duid():
    """Remove iwd's stored DUID so it generates a fresh one on the next start. This also rotates the DHCPv4
    client identifier iwd derives from it, which a captive portal can key on even as the MAC changes."""
    try:
        os.remove(DUID)
    except OSError:
        pass

def set_duid_rotate(on):
    """Enable/disable wiping the DUID before every iwd start (an iwd.service ExecStartPre drop-in)."""
    if on:
        os.makedirs(DROPIN_DIR, exist_ok=True)
        with open(DUID_DROPIN, "w") as f:
            f.write(f"[Service]\nExecStartPre=-/usr/bin/rm -f {DUID}\n")
        os.chmod(DUID_DROPIN, 0o644)
    elif os.path.exists(DUID_DROPIN):
        os.remove(DUID_DROPIN)
    run("systemctl", "daemon-reload")

def systemd_version():
    m = re.search(r"systemd (\d+)", run("systemctl", "--version").stdout)
    return int(m.group(1)) if m else 0

def wifi_hostname():
    """The name iwd announces, or '' when none is configured."""
    try:
        m = re.search(r"^ProtectHostname=private:(\S+)", open(DROPIN).read(), re.M)
        return m.group(1) if m else ""
    except OSError:
        return ""

def set_wifi_hostname(name, restart=True):
    """Give iwd (and only iwd) its own hostname. iwd's DHCP client announces gethostname(), and
    ProtectHostname=private:NAME runs the service in a private UTS namespace where that name is NAME,
    so the real system hostname is untouched. An empty name removes the override and stops sending one."""
    if name and systemd_version() < 256:
        sys.exit("needs systemd >= 256 (ProtectHostname=private:NAME)")
    if name:
        os.makedirs(DROPIN_DIR, exist_ok=True)
        with open(DROPIN, "w") as f:
            f.write(f"[Service]\nProtectHostname=private:{name}\n")
        os.chmod(DROPIN, 0o644)
    elif os.path.exists(DROPIN):
        os.remove(DROPIN)
    for p in profiles():
        edit_profile(p["_path"], "IPv4", "SendHostname", "true" if name else None)
    run("systemctl", "daemon-reload")
    if restart:
        restart_iwd()

def profiles():
    out = []
    try:
        names = os.listdir(IWD_DIR)
    except OSError:
        return out
    for fn in sorted(names):
        base, ext = os.path.splitext(fn)
        if ext not in (".psk", ".open", ".8021x"):
            continue
        ssid = bytes.fromhex(base[1:]).decode(errors="replace") if base.startswith("=") else base
        n = configparser.ConfigParser(strict=False, interpolation=None)
        n.optionxform = str
        n.read(os.path.join(IWD_DIR, fn))
        out.append({
            "ssid": ssid,
            "always": n.get("Settings", "AlwaysRandomizeAddress", fallback="false") == "true",
            "override": n.get("Settings", "AddressOverride", fallback=""),
            "sendHostname": n.get("IPv4", "SendHostname", fallback="false") == "true",
            "_path": os.path.join(IWD_DIR, fn),
        })
    return out

def edit_profile(p, section, key, value):
    c = configparser.ConfigParser(strict=False, interpolation=None)
    c.optionxform = str
    c.read(p)
    if not c.has_section(section):
        c.add_section(section)
    if value is None:
        c.remove_option(section, key)
    else:
        c[section][key] = value
    with open(p, "w") as f:
        c.write(f, space_around_delimiters=False)
    os.chmod(p, 0o600)

def ensure_network_mode():
    c = read_main()
    if not c.has_section("General"):
        c.add_section("General")
    if c["General"].get("AddressRandomization", "disabled") != "network":
        c["General"]["AddressRandomization"] = "network"
        c["General"].setdefault("AddressRandomizationRange", "nic")
        write_main(c)

def pia_settings(changes):
    """The PIA daemon owns settings.json and rewrites it on exit, so stop it, edit, start it again.
    (piactl has no setting for transport, port or killswitch.)"""
    f = "/opt/piavpn/etc/settings.json"
    run("systemctl", "stop", "piavpn")
    try:
        d = json.load(open(f))
        d.update(changes)
        with open(f, "w") as fh:
            json.dump(d, fh)
    finally:
        run("systemctl", "start", "piavpn")

def write_state():
    """World-readable mirror of the per-network policy (/var/lib/iwd is root-only)."""
    try:
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        os.chmod(STATE_DIR, 0o755)
        data = [{k: v for k, v in p.items() if k != "_path"} for p in profiles()]
        with open(STATE, "w") as f:
            json.dump(data, f)
        os.chmod(STATE, 0o644)
    except OSError:
        pass

def known_rules():
    live = [{k: v for k, v in p.items() if k != "_path"} for p in profiles()]
    if live:
        return live
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return []

def status():
    c = read_main()
    g = c["General"] if c.has_section("General") else {}
    cur = open(f"/sys/class/net/{IFACE}/address").read().strip() if os.path.exists(f"/sys/class/net/{IFACE}") else ""
    perm = ""
    r = run("ip", "-j", "link", "show", IFACE)
    try:
        perm = json.loads(r.stdout)[0].get("permaddr", "")
    except Exception:
        pass
    ssid = current_ssid()
    always = False
    if ssid and net_file(ssid):
        n = configparser.ConfigParser(strict=False, interpolation=None)
        n.optionxform = str
        n.read(net_file(ssid))
        always = n.get("Settings", "AlwaysRandomizeAddress", fallback="false") == "true"
    print(json.dumps({
        "mode": g.get("AddressRandomization", "disabled"),
        "range": g.get("AddressRandomizationRange", "full"),
        "mac": cur, "permanent": perm, "ssid": ssid, "always": always,
        "hostname": socket.gethostname(),                 # the real system hostname, never modified
        "wifiHostname": wifi_hostname(),                  # what Wi-Fi networks see ('' = nothing sent)
        "bootHostname": run("systemctl", "is-enabled", "rice-hostname.service").stdout.strip() == "enabled",
        "duidRotate": os.path.exists(DUID_DROPIN),
        "harden": os.path.exists("/etc/systemd/resolved.conf.d/rice.conf"),
        "dhcpHostname": wifi_hostname() != "",
        "rules": known_rules(),
    }))

UNIT = """[Unit]
Description=Pick a new random Wi-Fi hostname (iwd only; the system hostname is not touched)
Before=network-pre.target iwd.service systemd-networkd.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/rice/net-helper hostname random --no-restart

[Install]
WantedBy=multi-user.target
"""

def tell_user(msg):
    """a protection was turned off: always visible, so a program running as you cannot do it quietly (these stay
    prompt-free, for the bar's toggles and captive-portal sign-in)"""
    subprocess.run(["logger", "-t", "rice-net", msg], check=False)
    try:
        uid = int(os.environ.get("PKEXEC_UID", ""))
    except ValueError:
        return
    import pwd
    try:
        name = pwd.getpwuid(uid).pw_name
    except KeyError:
        return
    subprocess.run(["runuser", "-u", name, "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
                    "notify-send", "-a", "Network", "-u", "normal", "Protection off", msg],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)

def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__); return
    cmd = a[0]
    try:
        dispatch(cmd, a)
    finally:
        if os.geteuid() == 0 and cmd in ("mode", "always", "rotate", "duid", "duid-rotate", "rule", "dhcp-hostname", "hostname", "sync"):
            write_state()

def dispatch(cmd, a):
    if cmd == "sync":
        pass
    elif cmd == "status":
        status()
    elif cmd == "mode" and len(a) == 2 and a[1] in ("network", "once", "disabled"):
        c = read_main()
        if not c.has_section("General"): c.add_section("General")
        c["General"]["AddressRandomization"] = a[1]
        c["General"].setdefault("AddressRandomizationRange", "nic")
        write_main(c); restart_iwd()
    elif cmd == "range" and len(a) == 2 and a[1] in ("full", "nic"):
        c = read_main()
        if not c.has_section("General"): c.add_section("General")
        c["General"]["AddressRandomizationRange"] = a[1]
        write_main(c); restart_iwd()
    elif cmd == "always" and len(a) == 3 and a[2] in ("on", "off"):
        c = read_main()
        if c.get("General", "AddressRandomization", fallback="disabled") != "network":
            sys.exit("per-network randomization needs mode 'network'")
        set_always(a[1], a[2] == "on")
        restart_iwd()
    elif cmd == "rotate":
        c = read_main()
        if not c.has_section("General"): c.add_section("General")
        c["General"]["AddressRandomization"] = "network"
        c["General"].setdefault("AddressRandomizationRange", "nic")
        write_main(c)
        ssid = current_ssid()
        if ssid and net_file(ssid):
            set_always(ssid, True)
        restart_iwd()
    elif cmd == "duid":
        wipe_duid(); restart_iwd()
    elif cmd == "duid-rotate" and len(a) == 2 and a[1] in ("on", "off"):
        set_duid_rotate(a[1] == "on")
        restart_iwd()     # the ExecStartPre (when on) wipes the DUID now; a plain restart otherwise
    elif cmd == "hostname" and len(a) >= 2:
        name = random_hostname() if a[1] == "random" else a[1]
        if not re.fullmatch(r"[A-Za-z0-9-]{1,63}", name):
            sys.exit("invalid hostname")
        # INVOCATION_ID is set when systemd runs us (the boot unit, ordered before iwd): restarting iwd
        # from there would deadlock, and iwd has not started yet anyway
        restart = "--no-restart" not in a and "INVOCATION_ID" not in os.environ
        set_wifi_hostname(name, restart)
        print(name)
    elif cmd == "dhcp-hostname" and len(a) == 2 and a[1] in ("on", "off"):
        set_wifi_hostname((wifi_hostname() or random_hostname()) if a[1] == "on" else "")
    elif cmd == "rules":
        print(json.dumps([{k: v for k, v in p.items() if k != "_path"} for p in profiles()]))
    elif cmd == "rule" and len(a) >= 3 and a[2] in ("random", "stable", "custom"):
        path = next((p["_path"] for p in profiles() if p["ssid"] == a[1]), None)
        if not path:
            sys.exit(f"no saved profile for '{a[1]}'")
        ensure_network_mode()
        if a[2] == "random":
            edit_profile(path, "Settings", "AlwaysRandomizeAddress", "true"); edit_profile(path, "Settings", "AddressOverride", None)
        elif a[2] == "stable":
            edit_profile(path, "Settings", "AlwaysRandomizeAddress", None); edit_profile(path, "Settings", "AddressOverride", None)
        else:
            if len(a) != 4 or not re.fullmatch(r"([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}", a[3]):
                sys.exit("custom needs a MAC like aa:bb:cc:dd:ee:ff")
            edit_profile(path, "Settings", "AlwaysRandomizeAddress", None); edit_profile(path, "Settings", "AddressOverride", a[3].lower())
        restart_iwd()
    elif cmd == "pia-killswitch" and len(a) == 2 and a[1] in ("on", "auto", "off"):
        pia_settings({"killswitch": a[1]})
        if a[1] == "off":
            tell_user("VPN kill switch is off")
    elif cmd == "vpn-daemon" and len(a) == 2 and a[1] in VPN_UNITS:
        for name, unit in VPN_UNITS.items():
            if name != a[1] and run("systemctl", "cat", unit).returncode == 0:
                run("systemctl", "disable", "--now", unit)
        if run("systemctl", "cat", VPN_UNITS[a[1]]).returncode != 0:
            sys.exit(f"{VPN_UNITS[a[1]]}.service is not installed")
        r = run("systemctl", "enable", "--now", VPN_UNITS[a[1]])
        if r.returncode != 0:
            sys.exit(r.stderr.strip())
    elif cmd == "pia" and len(a) == 2 and a[1] in ("school", "auto"):
        if a[1] == "school":
            pia_settings({"method": "openvpn", "protocol": "tcp", "remotePortTCP": 443, "automaticTransport": False})
        else:
            pia_settings({"protocol": "udp", "remotePortTCP": 0, "remotePortUDP": 0, "automaticTransport": True})
    elif cmd == "boot-hostname" and len(a) == 2 and a[1] in ("on", "off"):
        if a[1] == "on":
            open("/etc/systemd/system/rice-hostname.service", "w").write(UNIT)
            run("systemctl", "daemon-reload")
            run("systemctl", "enable", "rice-hostname.service")
        else:
            run("systemctl", "disable", "rice-hostname.service")
    elif cmd == "pia-set" and len(a) >= 3:
        opt, val = a[1], a[2]
        onoff = {"on": True, "off": False}
        if opt == "multihop" and val in onoff and len(a) <= 4:
            loc = a[3] if len(a) == 4 else "auto"
            if not re.fullmatch(r"[a-z0-9-]{1,40}", loc):
                sys.exit("bad region")
            ch = {"proxyEnabled": onoff[val], "proxyType": "shadowsocks"}
            if onoff[val]:
                ch.update({"proxyShadowsocksLocation": loc, "method": "openvpn"})   # PIA only proxies OpenVPN
            pia_settings(ch)
        elif opt in ("mace", "obfuscation", "ipv6block") and val in onoff and len(a) == 3:
            pia_settings({{"mace": "enableMACE", "obfuscation": "wireguardObfuscation", "ipv6block": "blockIPv6"}[opt]: onoff[val]})
        else:
            sys.exit(__doc__)
    elif cmd == "dns-guard" and len(a) == 2 and a[1] in ("on", "off"):
        if a[1] == "off":
            tell_user("DNS guard off (sign-in mode): plain DNS until it is turned back on")
        if run("systemctl", "is-enabled", "rice-dns-guard.service").stdout.strip() == "enabled":
            run("systemctl", "start" if a[1] == "on" else "stop", "rice-dns-guard.service")
        # while signing in, the network's own DNS answers everything: sign-in pages work by rewriting DNS, and
        # many networks (schools) block DoH until you are signed in, or for good. DNS= / Domains= empty drop the
        # DoH server (and its ~. catch-all) for now; local DNSSEC validation (if on) fails on rewritten answers
        portal = "/run/systemd/resolved.conf.d/zz-rice-portal.conf"
        doh = os.path.exists("/etc/systemd/resolved.conf.d/rice-doh.conf")
        if doh or os.path.exists("/etc/systemd/resolved.conf.d/rice-dnssec.conf") or os.path.exists(portal):
            if a[1] == "off":
                os.makedirs(os.path.dirname(portal), exist_ok=True)
                open(portal, "w").write("[Resolve]\n" + ("DNS=\nDomains=\n" if doh else "") + "DNSSEC=no\n")
            elif os.path.exists(portal):
                os.remove(portal)
            run("systemctl", "restart", "systemd-resolved")
    elif cmd == "harden" and len(a) == 2 and a[1] in ("on", "off"):
        d = "/etc/systemd/resolved.conf.d"; f = d + "/rice.conf"; s = "/etc/sysctl.d/99-rice-ipv6.conf"
        if a[1] == "on":
            os.makedirs(d, exist_ok=True)
            open(f, "w").write("[Resolve]\nLLMNR=no\nMulticastDNS=no\n")
            open(s, "w").write("net.ipv6.conf.all.use_tempaddr=2\nnet.ipv6.conf.default.use_tempaddr=2\n")
            run("sysctl", "--system")
        else:
            for p in (f, s):
                if os.path.exists(p): os.remove(p)
        run("systemctl", "restart", "systemd-resolved")
    else:
        sys.exit(__doc__)

if __name__ == "__main__":
    main()
