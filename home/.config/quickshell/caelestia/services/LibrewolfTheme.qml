pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.services
import qs.utils

// Regenerates LibreWolf's chrome/colors.css (the --rice-* variables its userChrome theme reads)
// from caelestia's current scheme, so the browser follows the wallpaper theme. Takes effect on the
// next LibreWolf start (Firefox doesn't hot-reload userChrome), matching the old matugen flow.
Singleton {
    id: root

    readonly property string cssPath: Quickshell.env("HOME") + "/.config/librewolf/librewolf/6yv4qbnb.default-release/chrome/colors.css"

    function hex(c) {
        return "#" + [c.r, c.g, c.b].map(x => Math.round(x * 255).toString(16).padStart(2, "0")).join("");
    }

    function block() {
        const p = Colours.palette;
        return `  --rice-bg: ${hex(p.m3surface)};\n` + `  --rice-bg-low: ${hex(p.m3surfaceContainerLow)};\n` + `  --rice-bg-mid: ${hex(p.m3surfaceContainer)};\n` + `  --rice-bg-high: ${hex(p.m3surfaceContainerHigh)};\n` + `  --rice-fg: ${hex(p.m3onSurface)};\n` + `  --rice-fg-dim: ${hex(p.m3onSurfaceVariant)};\n` + `  --rice-outline: ${hex(p.m3outlineVariant)};\n` + `  --rice-accent: ${hex(p.m3primary)};\n` + `  --rice-accent-fg: ${hex(p.m3onPrimary)};\n` + `  --rice-accent-bg: ${hex(p.m3primaryContainer)};\n` + `  --rice-accent-bg-fg: ${hex(p.m3onPrimaryContainer)};\n` + `  --rice-tertiary: ${hex(p.m3tertiary)};\n` + `  --rice-error: ${hex(p.m3error)};\n`;
    }

    function write() {
        const b = block();
        cssFile.setText(`/* generated by caelestia from the current scheme */\n:root {\n${b}}\n@media (prefers-color-scheme: dark) {\n  :root {\n${b}  }\n}\n`);
    }

    FileView { id: cssFile; path: root.cssPath; printErrors: false }

    // rewrite whenever the scheme changes
    FileView {
        path: `${Paths.state}/scheme.json`
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: Qt.callLater(root.write)
    }

    Component.onCompleted: Qt.callLater(root.write)
}
