#!/bin/sh
# Per-network sign-in, started by the shell when you join a network with "sign in" on:
# VPN off + kill switch off -> run ~/.config/rice/network-login.sh until it gets online -> kill switch / VPN to the given settings.
#   network-login <vpn: wg|443|auto|off> <killswitch: on|auto|off> [iface] [login: 1|0]
# With login 0 only the kill switch and VPN steps run.
# Exit 0 ok, 3 sign-in failed (VPN and kill switch stay off so you are not stuck offline), 4 something could not be
# turned back on (the island says what). Killed half way: the DNS guard and the kill switch go back on anyway.
vpn=${1:-off}; ks=${2:-auto}; iface=${3:-wlan0}; login=${4:-1}
script="$HOME/.config/rice/network-login.sh"
log="$HOME/.cache/rice/network-login.log"
mkdir -p "$(dirname "$log")"
say() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >> "$log"; }
# step: also printed on stdout, where the shell shows it in the island
step() { say "$*"; printf '%s\n' "$*"; }
: > "$log"
if [ "$login" = 1 ]; then
[ -r "$script" ] || { say "missing $script"; exit 2; }

# whatever happens from here (the shell restarts, the session ends, it is killed), protections come back
finished=0
restore() {
  [ "$finished" = 1 ] && return
  say "interrupted: DNS guard and kill switch back on"
  pkexec /usr/local/lib/rice/net-helper dns-guard on >>"$log" 2>&1
  vpnctl killswitch "$ks" >>"$log" 2>&1
}
trap restore EXIT
trap 'exit 130' HUP INT TERM
step "Turning VPN and kill switch off"
vpnctl disconnect >/dev/null 2>&1
vpnctl killswitch off >>"$log" 2>&1
# a DNS guard (rice-dns-guard.service, if installed) blocks plain DNS, and the sign-in page needs it
pkexec /usr/local/lib/rice/net-helper dns-guard off >>"$log" 2>&1
for _ in 1 2 3 4 5 6 7 8; do
  [ "$(vpnctl state 2>/dev/null)" = Disconnected ] && break
  sleep 1
done

# the portal script's own "am I online" check can be wrong (slow portal, a stale 204), so judge by a real connectivity test
online() {
  [ "$(curl -s -m 5 --interface "$iface" -o /dev/null -w '%{http_code}' http://connectivitycheck.gstatic.com/generate_204)" = 204 ] && return 0
  [ "$(curl -s -m 5 --interface "$iface" http://detectportal.firefox.com/success.txt | tr -d '[:space:]')" = success ]
}
wait_online() { for _ in 1 2 3 4 5 6; do online && return 0; sleep 2; done; return 1; }

ok=0
cd "$(dirname "$log")" || exit 2
for try in 1 2 3 4; do
  step "Signing in$( [ "$try" -gt 1 ] && echo " (try $try)")"
  if IFACE="$iface" sh "$script" >>"$log" 2>&1; then rc=0; else rc=$?; fi
  step "Checking connection"
  if wait_online; then say "online (script exit $rc)"; ok=1; break; fi
  say "not online after attempt $try (script exit $rc)"
  sleep 3
done
if [ "$ok" != 1 ]; then
  step "Sign-in failed"
  finished=1
  pkexec /usr/local/lib/rice/net-helper dns-guard on >>"$log" 2>&1 || { step "Could not turn the DNS guard back on"; exit 4; }
  exit 3
fi
fi

failed=""
step "Kill switch $ks"
vpnctl killswitch "$ks" >>"$log" 2>&1 || failed="$failed kill switch"
case "$vpn" in
  off) say "vpn stays off" ;;
  *)   [ "$vpn" = 443 ] && vpn=school; step "Connecting VPN ($(vpnctl provider), $( case $vpn in wg|wireguard) echo WireGuard ;; school) echo restricted-network transport ;; *) echo $vpn ;; esac))"; qs -c caelestia ipc call vpn "$vpn" >>"$log" 2>&1
       # DoH back only once the VPN carries it: networks that block DoH cannot see it inside the tunnel
       vpnctl wait 45 || failed="$failed VPN" ;;
esac
if [ "$login" = 1 ]; then
  step "DNS back to DoH"; pkexec /usr/local/lib/rice/net-helper dns-guard on >>"$log" 2>&1 || failed="$failed DNS guard"
fi
finished=1
[ -z "$failed" ] || { step "Could not turn back on:$failed"; exit 4; }
exit 0
