#!/usr/bin/env bash
# Lock the session with the quickshell lock; fall back to swaylock if it never engages.

# Started under no_new_privs (a hardened service such as rice-remote or btlock)? A lock started from there could
# never check a password: the setuid helper that reads /etc/shadow loses its setuid, so every password is
# "wrong". Have niri start it the way the keybind does, or else the user's systemd (a fresh process either way).
if grep -q '^NoNewPrivs:[[:space:]]*1' /proc/self/status 2>/dev/null; then
  self=$(realpath "$0")
  sock=${NIRI_SOCKET:-$(ls "/run/user/$(id -u)"/niri.*.sock 2>/dev/null | head -1)}
  if [ -n "$sock" ] && NIRI_SOCKET=$sock niri msg action spawn -- "$self" 2>/dev/null; then exit 0; fi
  exec systemd-run --user --quiet --collect --unit="rice-lock-$$" "$self"
fi

STATE="$HOME/.cache/rice"; mkdir -p "$STATE"
# one at a time: two triggers at once (lock + before-sleep) used to start two locks, and the second one,
# refused by the compositor, stayed behind forever
exec 9>"$STATE/lock.lck"
flock -w 10 9 || exit 0

# already locked?
pgrep -x swaylock >/dev/null && exit 0
if [ -f "$STATE/locked" ] && pgrep -f '^quickshell -c lock' >/dev/null; then exit 0; fi

rm -f "$STATE/locked"
# 9>&-: the lock screen must not inherit the flock. It used to hold it for as long as it was up, so every
# other lock request queued behind it and, the moment you unlocked, started a brand-new lock
setsid -f quickshell -c lock >"$STATE/lock.log" 2>&1 </dev/null 9>&-

for _ in $(seq 40); do
  [ -f "$STATE/locked" ] && exit 0
  sleep 0.1
done

# the fancy lock did not come up: never leave the session open
pkill -f '^quickshell -c lock' 2>/dev/null
pgrep -x swaylock >/dev/null || exec swaylock -f 9>&-
