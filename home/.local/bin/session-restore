#!/usr/bin/env python3
"""Reopen the windows you had before a reboot, on the same workspaces.

  session-restore save        snapshot the open windows (the bar runs this every minute)
  session-restore restore     at login (niri spawn-at-startup): start them again and move each to its workspace
  session-restore on|off      turn restoring at login on or off (~/.config/rice/session.json)

Terminals (kitty) come back in the folder their shell was in. Apps that restore their own windows (browsers,
editors...) are started once. Saved in ~/.local/state/rice/session.json."""
import json, os, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/rice/session.json")
CFG = os.path.join(HOME, ".config/rice/session.json")
RESTORED = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "rice-session-restored")
SELF_RESTORING = {"librewolf", "firefox", "chromium", "google-chrome", "brave-browser", "code", "code-oss", "codium",
                  "Spotify", "spotify", "vesktop", "discord", "obsidian", "thunderbird", "signal"}
SKIP = {"org.quickshell", "xdg-desktop-portal-gnome", "", None}
TERMINALS = {"kitty"}

def niri(*a):
    r = subprocess.run(["niri", "msg", "-j", *a], capture_output=True, text=True, timeout=5)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None

def enabled():
    try: return json.load(open(CFG)).get("restore", True)
    except Exception: return True

def cmdline(pid):
    try: return [a.decode(errors="replace") for a in open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0") if a]
    except Exception: return []

def children(pid):
    try: return [int(c) for c in open(f"/proc/{pid}/task/{pid}/children").read().split()]
    except Exception: return []

def shell_cwd(pid):
    for c in children(pid):
        try: return os.readlink(f"/proc/{c}/cwd")
        except Exception: pass
    return None

def save():
    # do not overwrite the last session with the empty desktop of a fresh login before it was restored
    if os.path.exists(STATE) and not os.path.exists(RESTORED): return
    wins, wss = niri("windows"), niri("workspaces")
    if not wins or wss is None: return
    ws = {w["id"]: w for w in wss}
    out = []
    for w in wins:
        if w.get("app_id") in SKIP or not w.get("pid"): continue
        s = ws.get(w.get("workspace_id"), {})
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout") or [0, 0]
        e = {"app_id": w["app_id"], "title": w.get("title", ""), "output": s.get("output"), "ws": s.get("idx"),
             "col": pos[0], "floating": w.get("is_floating", False), "cmd": cmdline(w["pid"])}
        if w["app_id"] in TERMINALS: e["cwd"] = shell_cwd(w["pid"])
        if e["cmd"]: out.append(e)
    out.sort(key=lambda e: (e["output"] or "", e["ws"] or 0, e["col"] or 0))
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f: json.dump({"saved": time.time(), "windows": out}, f)
    os.replace(tmp, STATE)

def launch(e):
    cmd = e["cmd"]
    if e["app_id"] in TERMINALS:
        cmd = [cmd[0]] + (["--directory", e["cwd"]] if e.get("cwd") and os.path.isdir(e["cwd"]) else [])
    exe = cmd[0]
    if exe.startswith("/tmp/") or "--type=" in " ".join(cmd): return False
    if not (os.path.isabs(exe) and os.access(exe, os.X_OK)) and not any(os.access(os.path.join(p, exe), os.X_OK) for p in os.environ.get("PATH", "").split(":")):
        return False
    subprocess.Popen(cmd, cwd=e.get("cwd") or HOME, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return True

def restore():
    try:
        if not enabled(): return
        try: saved = json.load(open(STATE))["windows"]
        except Exception: return
        for _ in range(30):                     # wait for niri
            if niri("windows") is not None: break
            time.sleep(0.5)
        time.sleep(2)                           # let the autostart apps open first
        before = niri("windows") or []
        have = {w["app_id"] for w in before}
        known = {w["id"] for w in before}
        want, started = [], set()
        for e in saved:
            a = e["app_id"]
            if a in SELF_RESTORING:
                if a in have or a in started: continue
                if launch(e): started.add(a); want.append(e)
            else:
                if a in have and a not in TERMINALS: continue
                if launch(e): want.append(e)
        # move each new window to where it was, in the saved order per app
        deadline = time.time() + 45
        pending = list(want)
        while pending and time.time() < deadline:
            time.sleep(1)
            for w in niri("windows") or []:
                if w["id"] in known: continue
                for e in pending:
                    if e["app_id"] == w["app_id"]:
                        known.add(w["id"]); pending.remove(e)
                        if e.get("ws"):
                            if e.get("output"): subprocess.run(["niri", "msg", "action", "move-window-to-monitor", "--id", str(w["id"]), e["output"]], capture_output=True)
                            subprocess.run(["niri", "msg", "action", "move-window-to-workspace", "--window-id", str(w["id"]), "--focus", "false", str(e["ws"])], capture_output=True)
                        # self-restoring apps bring their own windows back: only the first one is ours to place
                        break
    finally:
        open(RESTORED, "w").close()

cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "save": save()
elif cmd == "restore": restore()
elif cmd in ("on", "off"):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    json.dump({"restore": cmd == "on"}, open(CFG, "w")); print("restore at login:", cmd)
else: sys.exit(__doc__)
