#!/bin/sh
# Launch Spotify with the wallpaper theme. The colours follow the wallpaper and light/dark live (spotify-theme + the "rice-live"
# spicetify extension); this only (re)applies the spicetify patch when the theme files changed or spotify-launcher replaced the client.
spot="$HOME/.local/share/spotify-launcher/install/usr/share/spotify"
stamp="$HOME/.cache/rice/spicetify-stamp"
want="$(cksum < "$HOME/.config/spicetify/Themes/rice/user.css" 2>/dev/null | cut -d' ' -f1) $(cksum < "$HOME/.config/spicetify/Extensions/rice-live.js" 2>/dev/null | cut -d' ' -f1) $(ls -ld --time-style=+%s "$spot/Apps/xpui" 2>/dev/null | awk '{print $6}') $([ -f "$spot/Apps/xpui/index.html" ] && echo patched)"
if ! pgrep -x spotify >/dev/null && command -v spicetify >/dev/null; then
  if [ "$want" != "$(cat "$stamp" 2>/dev/null)" ] || [ ! -f "$spot/Apps/xpui/extensions/rice-live.js" ]; then
    spicetify config current_theme rice extensions rice-live.js >/dev/null 2>&1
    spicetify backup apply >/dev/null 2>&1 || spicetify restore backup apply >/dev/null 2>&1
    echo "$want" > "$stamp"
  fi
  spotify-theme --regen >/dev/null 2>&1
fi
exec spotify-launcher "$@"
