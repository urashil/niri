#!/usr/bin/env bash
# Keyboard flavour for niri: "standard" (Super is Mod) or "chromebook" (the Alt key is Mod; the Search key takes Alt's place).
#   keyboard-mode              show the current setting
#   keyboard-mode auto         pick by the hardware (a Chromebook keyboard -> chromebook), remembered
#   keyboard-mode chromebook | standard    force one, remembered
# Writes ~/.config/niri/keyboard.kdl, which config.kdl includes; niri reloads it by itself.
set -u
dir="$HOME/.config/rice"; out="$HOME/.config/niri/keyboard.kdl"; pref="$dir/keyboard-mode"
mkdir -p "$dir" "$(dirname "$out")"

is_chromebook() {
  [ "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" = "Google" ] && return 0
  [ -d /sys/class/chromeos ] && return 0
  grep -qiE 'N: Name=".*(cros_ec|chromebook).*"' /proc/bus/input/devices 2>/dev/null
}

case "${1:-}" in
  "") echo "setting: $(cat "$pref" 2>/dev/null || echo auto); in effect: $(grep -q swap_lalt_lwin "$out" 2>/dev/null && echo chromebook || echo standard)"; exit 0 ;;
  auto|standard|chromebook) echo "$1" > "$pref" ;;
  *) echo "usage: keyboard-mode [auto|standard|chromebook]" >&2; exit 1 ;;
esac

mode=$(cat "$pref" 2>/dev/null || echo auto)
if [ "$mode" = auto ]; then is_chromebook && mode=chromebook || mode=standard; fi

# keep the machine's own layout / options (localectl), niri stops reading them once its xkb block has anything in it
loc=$(localectl status 2>/dev/null)
layout=$(sed -n 's/^ *X11 Layout: *//p' <<<"$loc"); variant=$(sed -n 's/^ *X11 Variant: *//p' <<<"$loc"); opts=$(sed -n 's/^ *X11 Options: *//p' <<<"$loc")
: "${layout:=us}"

{
  echo "// generated by keyboard-mode ($mode); do not edit"
  if [ "$mode" = chromebook ]; then
    # Chromebook: no Super key, Search sits where Super would be. Swapping Alt and Search makes the Alt key the Mod key,
    # so every Mod+... bind (and Super+Alt+L etc.) keeps the same shape under the thumb.
    opts="${opts:+$opts,}altwin:swap_lalt_lwin"
    echo "input {"
    echo "    keyboard {"
    echo "        xkb {"
    echo "            layout \"$layout\""
    [ -n "$variant" ] && echo "            variant \"$variant\""
    echo "            options \"$opts\""
    echo "        }"
    echo "    }"
    echo "}"
  fi
} > "$out.tmp"
cmp -s "$out.tmp" "$out" && rm -f "$out.tmp" || mv "$out.tmp" "$out"
echo "keyboard: $mode"
