#!/usr/bin/env bash
# Lid closed (niri switch-event): lock, then make sure the machine really sleeps.
# logind ignores lid events for HoldoffTimeoutSec (30 s) after a resume, so closing the lid soon after
# opening it never suspended; this finishes the job. Super caffeine (flag file): lock + screen off, no suspend.
STATE="$HOME/.cache/rice"
# Super caffeine: stay running (logind is blocked from suspending) but lock and turn the screen off
if [ -f "$STATE/super" ]; then
  # low power while closed (caffeine menu): remember the profile and keyboard light, lid-open puts them back
  if [ -f "$STATE/super-lowpower" ] && [ ! -f "$STATE/lowpower-saved" ]; then
    printf '%s %s\n' "$(powerprofilesctl get 2>/dev/null)" "$(brightnessctl -d "$(ls /sys/class/leds 2>/dev/null | grep -m1 kbd_backlight)" get 2>/dev/null || echo -)" > "$STATE/lowpower-saved"
    powerprofilesctl set power-saver 2>/dev/null
    brightnessctl -q -d "$(ls /sys/class/leds 2>/dev/null | grep -m1 kbd_backlight)" set 0 2>/dev/null
  fi
  # what to do is chosen in the caffeine menu (written to super-lid): lockoff (default) | lock | none
  case "$(cat "$STATE/super-lid" 2>/dev/null)" in
    none) exit 0 ;;
    lock) exec "$HOME/.local/bin/lock" ;;
    *)
      "$HOME/.local/bin/lock" &
      sleep 1
      niri msg action power-off-monitors
      exit 0 ;;
  esac
fi

"$HOME/.local/bin/lock" &
sleep 2

# still closed, and logind did not already start sleeping?
grep -q closed /proc/acpi/button/lid/*/state 2>/dev/null || exit 0
[ "$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager PreparingForSleep 2>/dev/null)" = "b true" ] && exit 0
[ -f "$STATE/super" ] && exit 0

# docked (another monitor attached): keep running, like logind's HandleLidSwitchDocked=ignore
n=$(niri msg -j outputs 2>/dev/null | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo 1)
[ "${n:-1}" -gt 1 ] && exit 0

exec systemctl suspend
