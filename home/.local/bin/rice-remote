#!/usr/bin/env python3
"""Phone page for the laptop: status (battery, temperature, super caffeine, awake jobs, Claude) plus four fixed
actions (lock, screen off, let it sleep, shut down). Meant to sit behind your own HTTPS reverse proxy; it also has its own login.

  rice-remote passwd       set the password (stored as a scrypt hash in ~/.config/rice/remote.json)
  rice-remote enable       install + start the systemd user service (listens on 127.0.0.1:8765)
  rice-remote disable      stop it
  rice-remote serve        run in the foreground (what the service runs)
  rice-remote origin <https://host>   the public address (needed for passkeys and the origin check)
  rice-remote tunnel ...   see `rice-remote tunnel --help`: a reverse SSH tunnel to a server's nginx

Passkeys: sign in once with the password, then "Add a passkey" (phone fingerprint / face). After that the passkey
signs you in; the password stays as a fallback unless you set "password_login": false in remote.json.
It installs as a PWA (Add to home screen).

Security: binds to localhost only (expose it through the proxy), password login with lockouts (5 misses per client
per 15 min, 20 misses in total per hour locks everyone out for an hour), HttpOnly + SameSite=Strict + Secure session
cookie, actions need POST + a custom header + a same-origin check, strict CSP, nothing user-supplied ever reaches a
command line. Settings in remote.json: port, bind, secure_cookie (set false only to try it over plain http locally),
trusted_proxies (whose X-Forwarded-For is believed)."""
import getpass, hashlib, hmac, html, http.server, json, os, secrets, socketserver, subprocess, sys, threading, time, urllib.parse

HOME = os.path.expanduser("~")
CFG = os.environ.get("RICE_REMOTE_CFG") or os.path.join(HOME, ".config/rice/remote.json")
RUN = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
BIN = os.path.join(HOME, ".local/bin")
N, R, P = 2 ** 15, 8, 1
SESSION_DAYS = 30
COOKIE = "rr_session"

# ---------------------------------------------------------------- config
def load_cfg():
    try:
        with open(CFG) as f: return json.load(f)
    except FileNotFoundError: return {}

def save_cfg(c):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    fd = os.open(CFG + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: json.dump(c, f, indent=2)
    os.replace(CFG + ".tmp", CFG)

def kdf(pw, salt, n=N, r=R, p=P):
    return hashlib.scrypt(pw.encode(), salt=salt, n=n, r=r, p=p, maxmem=64 * 1024 * 1024, dklen=32)

# ---------------------------------------------------------------- status (read only)
def read(path, default=""):
    try:
        with open(path) as f: return f.read().strip()
    except Exception: return default

def battery():
    for b in sorted(os.listdir("/sys/class/power_supply")):
        d = f"/sys/class/power_supply/{b}"
        if read(f"{d}/type") != "Battery": continue
        pw = read(f"{d}/power_now")
        if not pw and read(f"{d}/current_now") and read(f"{d}/voltage_now"):
            pw = str(int(read(f"{d}/current_now")) * int(read(f"{d}/voltage_now")) // 1000000)
        return {"percent": int(read(f"{d}/capacity", "0") or 0), "status": read(f"{d}/status"),
                "watts": round(int(pw) / 1e6, 1) if pw.isdigit() else None}
    return None

def temperature():
    best = None
    for h in os.listdir("/sys/class/hwmon"):
        d = f"/sys/class/hwmon/{h}"
        if read(f"{d}/name") not in ("coretemp", "k10temp", "zenpower", "cpu_thermal"): continue
        for f in os.listdir(d):
            if f.startswith("temp") and f.endswith("_input"):
                v = read(f"{d}/{f}")
                if v.isdigit(): best = max(best or 0, int(v) / 1000)
    return round(best) if best else None

def memory():
    m = {}
    for line in read("/proc/meminfo").splitlines():
        k, v = line.split(":", 1); m[k] = int(v.split()[0])
    return round(100 * (1 - m.get("MemAvailable", 0) / max(1, m.get("MemTotal", 1))))

def proc_running(needle):
    for p in os.listdir("/proc"):
        if not p.isdigit(): continue
        try:
            with open(f"/proc/{p}/cmdline", "rb") as f: c = f.read().split(b"\0")
        except Exception: continue
        if needle(c): return True
    return False

def awake_jobs():
    d = os.path.join(RUN, "awake"); out = []
    if os.path.isdir(d):
        for f in os.listdir(d):
            if not f.endswith(".json") or not os.path.isdir(f"/proc/{f[:-5]}"): continue
            try:
                j = json.load(open(os.path.join(d, f)))
                out.append({"name": str(j.get("name", ""))[:60], "minutes": int((time.time() - int(j.get("start", time.time()))) / 60)})
            except Exception: pass
    return out

def claude_sessions():
    try:
        l = json.loads(subprocess.run([f"{BIN}/claude-island", "list"], capture_output=True, text=True, timeout=5).stdout)
        return [{"project": s.get("project", "")[:40], "state": s.get("state", "")} for s in l]
    except Exception: return []

_usage = {"t": 0, "v": None}
def claude_usage():
    if time.time() - _usage["t"] > 300:
        _usage["t"] = time.time()
        try:
            d = json.loads(subprocess.run([f"{BIN}/claude-usage"], capture_output=True, text=True, timeout=60).stdout)
            l = d.get("limits") or {}
            _usage["v"] = {"session": (l.get("five_hour") or {}).get("utilization"), "weekly": (l.get("seven_day") or {}).get("utilization")}
        except Exception: pass
    return _usage["v"]

def status():
    up = float(read("/proc/uptime", "0").split()[0])
    lid = read(next((f"/proc/acpi/button/lid/{d}/state" for d in os.listdir("/proc/acpi/button/lid")), ""), "") if os.path.isdir("/proc/acpi/button/lid") else ""
    return {
        "time": int(time.time()),
        "uptime_h": round(up / 3600, 1),
        "battery": battery(),
        "temp_c": temperature(),
        "load": read("/proc/loadavg").split()[:3],
        "memory_pct": memory(),
        "lid": "closed" if "closed" in lid else "open" if lid else None,
        "super_caffeine": os.path.exists(os.path.join(HOME, ".cache/rice/super")),
        "locked": proc_running(lambda c: len(c) > 2 and c[0].endswith(b"quickshell") and b"lock" in c[1:4]),
        "awake": awake_jobs(),
        "claude": {"sessions": claude_sessions(), "usage": claude_usage()},
    }

# ---------------------------------------------------------------- actions (fixed commands only)
def run(*cmd):
    # as its own transient unit: outside this service's sandbox, and not killed when the service restarts
    subprocess.Popen(["systemd-run", "--user", "--quiet", "--collect", "--"] + list(cmd), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

ACTIONS = {
    "lock": lambda: run(f"{BIN}/lock"),
    "screen-off": lambda: run("niri", "msg", "action", "power-off-monitors"),
    # super caffeine off, lock, then suspend (logind lets it now)
    "sleep": lambda: run("sh", "-c", f"qs -c bar ipc call caffeine off; {BIN}/lock & sleep 2; systemctl suspend"),
    "shutdown": lambda: run("systemctl", "poweroff"),
}

# ---------------------------------------------------------------- auth state
lock = threading.Lock()
kdf_lock = threading.Lock()             # one scrypt at a time: no memory blow-up from parallel logins
sessions = {}                           # sha256(token) -> expiry
fails = {}                              # client -> [timestamps]
global_fails = []

def client_key(h):
    peer = h.client_address[0]
    xff = h.headers.get("X-Forwarded-For")
    if xff and peer in h.server.cfg.get("trusted_proxies", ["127.0.0.1", "::1"]):
        return xff.split(",")[-1].strip()[:64]
    return peer

def locked_out(key):
    now = time.time()
    with lock:
        global_fails[:] = [t for t in global_fails if now - t < 3600]
        fails[key] = [t for t in fails.get(key, []) if now - t < 900]
        return len(fails[key]) >= 5 or len(global_fails) >= 20

def note_fail(key):
    with lock:
        now = time.time()
        fails.setdefault(key, []).append(now); global_fails.append(now)

def new_session():
    tok = secrets.token_urlsafe(32)
    with lock:
        now = time.time()
        for k in [k for k, v in sessions.items() if v < now]: del sessions[k]
        if len(sessions) >= 20: del sessions[min(sessions, key=sessions.get)]
        sessions[hashlib.sha256(tok.encode()).hexdigest()] = now + SESSION_DAYS * 86400
    return tok

def session_ok(h):
    c = h.headers.get("Cookie", "")
    for part in c.split(";"):
        k, _, v = part.strip().partition("=")
        if k == COOKIE and v:
            d = hashlib.sha256(v.encode()).hexdigest()
            with lock:
                exp = sessions.get(d)
                if exp and exp > time.time(): return d
    return None


# ---------------------------------------------------------------- passkeys (WebAuthn)
import base64
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec, ed25519, padding, rsa
from cryptography.exceptions import InvalidSignature

KEYS = os.environ.get("RICE_REMOTE_KEYS") or os.path.join(HOME, ".local/state/rice-remote/passkeys.json")
pending = {}                            # challenge -> (kind, expiry)

def b64u(b): return base64.urlsafe_b64encode(b).rstrip(b"=").decode()
def unb64u(s): return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))

def load_keys():
    try:
        with open(KEYS) as f: return json.load(f)
    except FileNotFoundError: return []

def save_keys(k):
    os.makedirs(os.path.dirname(KEYS), mode=0o700, exist_ok=True)
    fd = os.open(KEYS + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: json.dump(k, f, indent=2)
    os.replace(KEYS + ".tmp", KEYS)

def cbor(b, i=0):
    """Minimal CBOR decoder (what WebAuthn uses): returns (value, next index)."""
    ib = b[i]; mt, ai = ib >> 5, ib & 31; i += 1
    if ai < 24: n = ai
    elif ai == 24: n = b[i]; i += 1
    elif ai == 25: n = int.from_bytes(b[i:i + 2], "big"); i += 2
    elif ai == 26: n = int.from_bytes(b[i:i + 4], "big"); i += 4
    elif ai == 27: n = int.from_bytes(b[i:i + 8], "big"); i += 8
    else: raise ValueError("indefinite CBOR not supported")
    if mt == 0: return n, i
    if mt == 1: return -1 - n, i
    if mt == 2: return bytes(b[i:i + n]), i + n
    if mt == 3: return b[i:i + n].decode(), i + n
    if mt == 4:
        out = []
        for _ in range(n): v, i = cbor(b, i); out.append(v)
        return out, i
    if mt == 5:
        out = {}
        for _ in range(n): k, i = cbor(b, i); v, i = cbor(b, i); out[k] = v
        return out, i
    if mt == 7: return {20: False, 21: True, 22: None}.get(n), i
    raise ValueError("unsupported CBOR")

def cose_to_pem(k):
    kty, alg = k.get(1), k.get(3)
    if kty == 2 and k.get(-1) == 1:
        pub = ec.EllipticCurvePublicNumbers(int.from_bytes(k[-2], "big"), int.from_bytes(k[-3], "big"), ec.SECP256R1()).public_key()
    elif kty == 1 and k.get(-1) == 6:
        pub = ed25519.Ed25519PublicKey.from_public_bytes(k[-2])
    elif kty == 3:
        pub = rsa.RSAPublicNumbers(int.from_bytes(k[-2], "big"), int.from_bytes(k[-1], "big")).public_key()
    else: raise ValueError("unsupported key type")
    return pub.public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo).decode(), alg

def verify_sig(pem, alg, sig, data):
    pub = serialization.load_pem_public_key(pem.encode())
    if alg == -7: pub.verify(sig, data, ec.ECDSA(hashes.SHA256()))
    elif alg == -8: pub.verify(sig, data)
    elif alg == -257: pub.verify(sig, data, padding.PKCS1v15(), hashes.SHA256())
    else: raise InvalidSignature()

def new_challenge(kind):
    now = time.time()
    with lock:
        for c in [c for c, v in pending.items() if v[1] < now]: del pending[c]
        if len(pending) > 50: return None
        ch = b64u(secrets.token_bytes(32))
        pending[ch] = (kind, now + 300)
    return ch

def take_challenge(ch, kind):
    with lock:
        v = pending.pop(ch, None)
    return v is not None and v[0] == kind and v[1] > time.time()

def check_client_data(cfg, raw, kind):
    cd = json.loads(raw)
    if cd.get("type") != kind: raise ValueError("wrong type")
    if cd.get("origin") != cfg.get("origin"): raise ValueError("wrong origin")
    if not take_challenge(cd.get("challenge", ""), kind): raise ValueError("unknown or expired challenge")

def check_auth_data(cfg, ad):
    if ad[:32] != hashlib.sha256(cfg["rp_id"].encode()).digest(): raise ValueError("wrong rp id")
    flags = ad[32]
    if not (flags & 1 and flags & 4): raise ValueError("user presence / verification missing")
    return flags, int.from_bytes(ad[33:37], "big")

def passkey_register(cfg, j):
    raw = unb64u(j["clientDataJSON"])
    check_client_data(cfg, raw, "webauthn.create")
    att, _ = cbor(unb64u(j["attestationObject"]))
    ad = att["authData"]
    flags, count = check_auth_data(cfg, ad)
    if not flags & 0x40: raise ValueError("no credential data")
    n = int.from_bytes(ad[53:55], "big")
    cred_id = ad[55:55 + n]
    key, _ = cbor(ad, 55 + n)
    pem, alg = cose_to_pem(key)
    keys = load_keys()
    if any(k["id"] == b64u(cred_id) for k in keys): raise ValueError("already registered")
    name = str(j.get("name") or "Passkey")[:40]
    keys.append({"id": b64u(cred_id), "pem": pem, "alg": alg, "count": count, "name": name, "added": int(time.time())})
    save_keys(keys)

def passkey_login(cfg, j):
    keys = load_keys()
    k = next((k for k in keys if k["id"] == j.get("id")), None)
    if not k: raise ValueError("unknown passkey")
    raw = unb64u(j["clientDataJSON"])
    check_client_data(cfg, raw, "webauthn.get")
    ad = unb64u(j["authenticatorData"])
    _, count = check_auth_data(cfg, ad)
    verify_sig(k["pem"], k["alg"], unb64u(j["signature"]), ad + hashlib.sha256(raw).digest())
    if count and k["count"] and count <= k["count"]: raise ValueError("signature counter went backwards (cloned key?)")
    k["count"] = count; k["used"] = int(time.time())
    save_keys(keys)

# ---------------------------------------------------------------- pages
