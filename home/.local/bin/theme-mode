#!/usr/bin/env bash
# theme-mode [dark|light|toggle]: switch caelestia (and, through its postHook rice-theme-sync, every app) to light
# or dark. The choice sticks for the wallpaper on screen, like the old theme-mode: next time it comes up, it comes
# up in this mode. (`wallpaper mode <file> auto` hands it back to caelestia's automatic pick.)
set -u
cur=$(python3 -I -c 'import json,os;print(json.load(open(os.path.expanduser("~/.local/state/caelestia/scheme.json"))).get("mode","dark"))' 2>/dev/null)
[ "$cur" = light ] || cur=dark
case "${1:-toggle}" in
  toggle) [ "$cur" = dark ] && mode=light || mode=dark ;;
  dark|light) mode=$1 ;;
  *) echo "usage: theme-mode [dark|light|toggle]" >&2; exit 1 ;;
esac
wall=$(cat "$HOME/.local/state/caelestia/wallpaper/path.txt" 2>/dev/null)
[ -n "$wall" ] && "$HOME/.local/bin/rice-theme-sync" --mode "$wall" "$mode"
exec caelestia scheme set -m "$mode"
