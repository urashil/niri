#!/usr/bin/env bash
# container [command...]   an Alpine box for AI agents (podman): the current folder is mounted at the same path, you are the same
#                          uid inside (files keep your ownership) with password-less sudo, and container root is an unprivileged
#                          host uid (your /etc/subuid range), so sudo inside cannot touch the host.
#                          Podman runs as root through a small fixed helper (/usr/local/lib/aibox/aibox-run, allowed without a
#                          password by /etc/sudoers.d/aibox), so unprivileged user namespaces stay off in the kernel.
#                          Every box shares one persistent 16 GB root (/var/lib/aibox/root, an ext4 image): packages you add
#                          and the Claude / Gemini / Antigravity sign-ins in its home (~/.claude, ~/.claude.json, ~/.gemini) stay.
# container setup          one-time root setup (podman, the helper, the uid range, the 16 GB image)
# container reset [--all]  rebuild the shared root from fresh Alpine; keeps /home unless --all
# container df             space used in the shared root
# container sync [--host]  copy the Claude Code sign-in from this machine into the box (--host: from the box to this machine)
# container git [on|off]   hand the box your git identity + GitHub push access (your gh token, used only as git's credential)
# container gh [on|off]    hand the box the gh CLI sign-in (GH_TOKEN): deploy logs, Actions runs, PRs
# container status         what the boxes get
#   one run only: container [--git|--no-git] [--gh|--no-gh] [command...]
set -euo pipefail

BASE=/var/lib/aibox
IMG=$BASE/root.img
ROOT=$BASE/root
HELPER=/usr/local/lib/aibox/aibox-run
HELPER_SRC="$HOME/dotfiles/root$HELPER"
ME=$(id -un)

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/container/settings"
setting() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -1; }
set_setting() {
    mkdir -p "$(dirname "$CONF")"
    { grep -v "^$1=" "$CONF" 2>/dev/null || true; echo "$1=$2"; } > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
}

die() { printf 'container: %s\n' "$*" >&2; exit 1; }

setup() {
    [ "$(id -u)" -ne 0 ] || die "run setup as yourself (it uses sudo)"
    [ -f "$HELPER_SRC" ] || die "missing $HELPER_SRC"
    echo "==> podman"
    sudo pacman -S --needed --noconfirm podman crun passt
    # an earlier version turned unprivileged user namespaces on for rootless podman: not needed
    if [ -f /etc/sysctl.d/60-aibox-userns.conf ]; then
        echo "==> unprivileged user namespaces back off"
        sudo rm -f /etc/sysctl.d/60-aibox-userns.conf
        sudo sysctl -q -w kernel.unprivileged_userns_clone=0
    fi
    if ! grep -q "^$ME:" /etc/subuid || ! grep -q "^$ME:" /etc/subgid; then
        # past every range already handed out
        start=$(awk -F: '{e=$2+$3; if (e>m) m=e} END {print (m>165536?m:165536)}' /etc/subuid /etc/subgid)
        sudo usermod --add-subuids "$start-$((start + 65535))" --add-subgids "$start-$((start + 65535))" "$ME"
    fi
    echo "==> helper, allowed without a password for $ME"
    sudo install -Dm755 -o root -g root "$HELPER_SRC" "$HELPER"
    printf '%s ALL=(root) NOPASSWD: %s\n' "$ME" "$HELPER" | sudo tee /etc/sudoers.d/aibox.new >/dev/null
    sudo chmod 440 /etc/sudoers.d/aibox.new
    sudo visudo -cqf /etc/sudoers.d/aibox.new && sudo mv /etc/sudoers.d/aibox.new /etc/sudoers.d/aibox
    echo "==> 16 GB shared root ($IMG)"
    sudo install -d -m 755 "$BASE"
    sudo install -d -m 755 "$ROOT"
    if [ ! -f "$IMG" ]; then
        sudo truncate -s 16G "$IMG"
        sudo mkfs.ext4 -q -L aibox -m 0 "$IMG"
    fi
    sudo tee /etc/systemd/system/var-lib-aibox-root.mount >/dev/null <<UNIT
[Unit]
Description=Shared root for the container command

[Mount]
What=$IMG
Where=$ROOT
Type=ext4
Options=loop,noatime,nodev

[Install]
WantedBy=multi-user.target
UNIT
    sudo systemctl daemon-reload
    sudo systemctl enable --now var-lib-aibox-root.mount
    echo "done: run 'container' in a project folder (the first run fills the shared root, a few minutes)"
}

check() {
    command -v podman >/dev/null || die "podman is not installed: run 'container setup'"
    [ -x "$HELPER" ] || die "the helper is not installed: run 'container setup'"
    mountpoint -q "$ROOT" || die "$ROOT is not mounted: run 'container setup'"
}

# the Claude Code sign-in: the token file, plus the account fields of ~/.claude.json (the rest of each side's settings stays)
sync_claude() {
    local box="$ROOT/home/$ME" from to
    [ -d "$box" ] || die "the box has no home yet: run 'container true' first"
    if [ "${1:-}" = --host ]; then from=$box; to=$HOME; else from=$HOME; to=$box; fi
    [ -f "$from/.claude/.credentials.json" ] || die "not signed in to Claude Code in ${from/#$box/the box}"
    mkdir -p "$to/.claude"
    install -m 600 "$from/.claude/.credentials.json" "$to/.claude/.credentials.json"
    local acct; acct=$(jq '{oauthAccount, hasCompletedOnboarding, lastOnboardingVersion} | with_entries(select(.value != null))' "$from/.claude.json")
    if [ -f "$to/.claude.json" ]; then
        jq --argjson a "$acct" '. + $a' "$to/.claude.json" > "$to/.claude.json.tmp"
    else
        printf '%s\n' "$acct" > "$to/.claude.json.tmp"
    fi
    chmod 600 "$to/.claude.json.tmp" && mv "$to/.claude.json.tmp" "$to/.claude.json"
    echo "Claude Code sign-in copied $([ "${1:-}" = --host ] && echo 'from the box to this machine' || echo 'into the box')"
}

toggle() {   # toggle git|gh [on|off]
    case "${2:-}" in
        on|off) set_setting "$1" "$2" ;;
        "") ;;
        *) die "usage: container $1 [on|off]" ;;
    esac
    echo "$1: $(setting "$1" || true)" | sed 's/: $/: off/'
}

# the credentials the box gets this time, in a private folder on the user's tmpfs, mounted read-only at /run/aibox
SECRETS=""
cleanup() { [ -n "$SECRETS" ] && rm -rf "$SECRETS"; }
secrets() {
    local git=$1 gh=$2
    [ "$git" = on ] || [ "$gh" = on ] || return 0
    command -v gh >/dev/null || die "gh is not installed here"
    local token; token=$(gh auth token 2>/dev/null) || die "gh is not signed in here (gh auth login)"
    SECRETS="/run/user/$(id -u)/aibox-$$"
    trap cleanup EXIT
    (umask 077; mkdir "$SECRETS")
    if [ "$git" = on ]; then
        (umask 077; printf '%s\n' "$token" > "$SECRETS/git-token")
        local name email; name=$(git config --global user.name || true); email=$(git config --global user.email || true)
        # the box's own ~/.gitconfig still applies; on top: who you are, and the token for github.com pushes
        cat > "$SECRETS/gitconfig" <<EOF
[include]
	path = ~/.gitconfig
[user]
	name = $name
	email = $email
[credential "https://github.com"]
	helper =
	helper = "!f() { test \"\$1\" = get && echo username=x-access-token && echo password=\$(cat /run/aibox/git-token); }; f"
EOF
    fi
    [ "$gh" = on ] && (umask 077; printf '%s\n' "$token" > "$SECRETS/gh-token")
    return 0
}

case "${1:-}" in
    setup) setup ;;
    git|gh) toggle "$1" "${2:-}" ;;
    status) echo "git: $(setting git | grep . || echo off)"; echo "gh: $(setting gh | grep . || echo off)" ;;
    reset)
        check
        all=0; [ "${2:-}" = --all ] && all=1
        printf 'rebuild the shared root%s? [y/N] ' "$([ $all = 1 ] && echo ', including /home (sign-ins)')"
        read -r a; [ "$a" = y ] || exit 1
        exec sudo "$HELPER" fill "$([ $all = 1 ] && echo all || echo keep)" ;;
    sync) check; sync_claude "${2:-}" ;;
    df) check; df -h "$ROOT" | tail -1 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        check
        git=$(setting git); gh=$(setting gh)
        while [ $# -gt 0 ]; do
            case "$1" in
                --git) git=on ;; --no-git) git=off ;;
                --gh) gh=on ;; --no-gh) gh=off ;;
                *) break ;;
            esac
            shift
        done
        secrets "${git:-off}" "${gh:-off}"
        # not exec: the credentials folder is removed when the box ends
        sudo "$HELPER" box ${SECRETS:+--secrets "$SECRETS"} -- "$@" ;;
esac
