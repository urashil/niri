#!/usr/bin/env bash
# wallpaper [next|prev|random|restore|set <file>|mode <file> [light|dark|auto]]
# Thin front for caelestia (it draws the wallpaper and builds the colour scheme); its theme.postHook,
# rice-theme-sync, carries the colours to kitty, niri, GTK, LibreWolf, Spotify, nvim, SDDM.
# Light/dark: caelestia picks it from the image ("auto") unless you saved a choice for that wallpaper
# (`wallpaper mode <file> light|dark`, the picker's sun/moon badge, or toggling light/dark while it is on).
set -u
DIR="${CAELESTIA_WALLPAPERS_DIR:-$HOME/Pictures/Wallpapers}"
CUR_F="$HOME/.local/state/caelestia/wallpaper/path.txt"
cur() { cat "$CUR_F" 2>/dev/null; }
set_wall() { [ -f "$1" ] || { echo "not found: $1" >&2; exit 1; }; exec caelestia wallpaper -f "$(realpath "$1")"; }
list() { find -L "$DIR" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) | sort; }

step() {
  local c files n i=-1
  c=$(cur); mapfile -t files < <(list); n=${#files[@]}
  [ "$n" -gt 0 ] || { echo "no wallpapers in $DIR" >&2; exit 1; }
  for k in "${!files[@]}"; do [ "${files[$k]}" = "$c" ] && i=$k; done
  if [ "$1" = next ]; then i=$(( (i + 1) % n )); else i=$(( (i - 1 + n) % n )); fi
  set_wall "${files[$i]}"
}

case "${1:-next}" in
  next|prev) step "$1" ;;
  random) exec caelestia wallpaper -r ;;
  set) [ -n "${2:-}" ] || { echo "usage: wallpaper set <file>" >&2; exit 1; }; set_wall "$2" ;;
  restore) exec "$HOME/.local/bin/rice-theme-sync" ;;   # caelestia restores the wallpaper itself; re-sync the apps
  mode)
    [ -n "${2:-}" ] || { echo "usage: wallpaper mode <file> [light|dark|auto]" >&2; exit 1; }
    if [ -z "${3:-}" ]; then
      python3 -I -c 'import json,sys,os
try: print(json.load(open(sys.argv[1])).get(os.path.basename(sys.argv[2]),"auto"))
except Exception: print("auto")' "$HOME/.config/rice/wallpaper-modes.json" "$2"; exit 0
    fi
    case "$3" in light|dark|auto) ;; *) echo "mode must be light, dark or auto" >&2; exit 1 ;; esac
    "$HOME/.local/bin/rice-theme-sync" --mode "$2" "$3"
    # the wallpaper on screen: apply now (auto: let caelestia measure it again)
    if [ "$(realpath "$2")" = "$(cur)" ]; then
      if [ "$3" = auto ]; then exec caelestia wallpaper -f "$(cur)"; else exec caelestia scheme set -m "$3"; fi
    fi ;;
  *) echo "usage: wallpaper [next|prev|random|restore|set <file>|mode <file> [light|dark|auto]]" >&2; exit 1 ;;
esac
