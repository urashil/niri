#!/usr/bin/env bash
# Connect the VPN (PIA, Mullvad or IVPN, whichever vpnctl uses) once per login. Turn it off in quick settings > VPN >
# "Connect at startup", or with: vpn-autoconnect off | on | status
CONF="$HOME/.config/rice/vpn.json"
FLAG="${XDG_RUNTIME_DIR:-/tmp}/rice-vpn-autoconnect"

enabled() { [ "$(jq -r '.autoConnect' "$CONF" 2>/dev/null)" != false ]; }
setting() { # keep the other keys (provider, per-client choices)
  mkdir -p "$(dirname "$CONF")"
  local cur; cur=$(cat "$CONF" 2>/dev/null); jq -e . >/dev/null 2>&1 <<<"$cur" || cur='{}'
  jq --argjson v "$1" '.autoConnect = $v' <<<"$cur" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
}

case "${1:-}" in
  off) setting false; echo "VPN will not connect at startup"; exit 0 ;;
  on) setting true; echo "VPN will connect at startup"; exit 0 ;;
  status) enabled && echo on || echo off; exit 0 ;;
esac

enabled || exit 0
[ -e "$FLAG" ] && exit 0            # already handled this login (a restarted bar must not undo a manual disconnect)
: > "$FLAG"

# the daemon starts with the system; wait for it to answer
state=""
for _ in $(seq 1 40); do
  state=$(vpnctl state 2>/dev/null)
  case "$state" in ""|Unavailable) sleep 2 ;; *) break ;; esac
done
case "$state" in ""|Unavailable) exit 1 ;; esac
enabled || exit 0                    # switched off while we waited
[ "$state" = Disconnected ] && vpnctl connect
exit 0
